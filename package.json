{
  "name": "lol-bingo",
  "private": true,
  "version": "1.0.0",
  "description": "英雄聯盟賓果：多人連線網頁遊戲（Vue 3 + Socket.IO on Vercel Functions + Upstash Redis）",
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan \"vite\" \"tsx watch server/dev.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "images": "tsx scripts/fetch-champion-images.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "ioredis-mock": "^8.13.1",
    "sharp": "^0.34.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true
  }
}
