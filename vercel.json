{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/socket-io.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/socket-io/:path*", "destination": "/api/socket-io" }
  ]
}
